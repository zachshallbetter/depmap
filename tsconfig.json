{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["viewer/**/*", "src/**/*", "sample-app/**/*"],
  "exclude": ["node_modules", "viewer/dist"]
}
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "viewer/**/*.ts",
    "viewer/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "sample-app/**/*.ts",
    "sample-app/**/*.tsx"
  ],
  "exclude": ["node_modules", "viewer/dist", "viewer/layout-worker.js"]
}